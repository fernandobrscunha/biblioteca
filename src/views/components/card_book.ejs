<!-- Livro -->
<div class="col-3">
    <div class="card shadow">
        <img class="card-img-top pt-4 px-4"
            src="https://capricho.abril.com.br/wp-content/uploads/2017/06/download.jpg?quality=85&strip=info" alt="">
        <div class="card-body">
            <h5 class="card-title">
                <%= book.title %>
            </h5>
            <p class="text-secondary">J. K. Rowling</p>
            <button class="btn btn-dark w-100">Ler agora</button>
        </div><!-- fim do card-body -->
    </div><!-- fim do card -->
</div><!-- fim da col(Livro) -->