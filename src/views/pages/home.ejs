<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Biblioteca Virtual — um acervo digital de livros para todos os leitores.">
    <title>Biblioteca Virtual — Acervo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  </head>
  <body class="d-flex flex-column min-vh-100 bg-body text-body">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg sticky-top bg-white border-bottom border-success-subtle">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-body-emphasis" href="/">
          <span class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-3 p-2">
            <i class="bi bi-book-half"></i>
          </span>
          Biblioteca<span class="text-success">Virtual</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navPrincipal" aria-controls="navPrincipal" aria-expanded="false" aria-label="Abrir menu">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navPrincipal">
          <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-lg-1">
            <li class="nav-item">
              <a class="nav-link active fw-semibold text-success" href="/"><i class="bi bi-house-door me-1"></i>Início</a>
            </li>
            <li class="nav-item">
              <a class="nav-link link-body-emphasis" href="#acervo"><i class="bi bi-collection me-1"></i>Acervo</a>
            </li>
            <li class="nav-item ms-lg-2">
              <a class="btn btn-success btn-sm rounded-pill px-3" href="/books/new">
                <i class="bi bi-plus-lg me-1"></i>Cadastrar livro
              </a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Hero -->
    <header class="bg-success-subtle">
      <div class="container py-5 my-lg-3">
        <div class="row align-items-center g-5">
          <div class="col-lg-7">
            <span class="badge bg-white text-success border border-success-subtle rounded-pill px-3 py-2 mb-3">
              <i class="bi bi-stars me-1 text-warning"></i>Bem-vindo(a)
            </span>
            <h1 class="display-4 fw-bolder lh-1 mb-3 text-body-emphasis">
              Sua próxima história <span class="text-success">começa</span> aqui
            </h1>
            <p class="lead text-success-emphasis opacity-75 mb-4">Explore um acervo em constante crescimento e descubra livros que vão te acompanhar em todas as fases da vida.</p>
            <div class="d-flex flex-wrap gap-2">
              <a href="#acervo" class="btn btn-success btn-lg rounded-pill px-4 fw-semibold">
                <i class="bi bi-arrow-down me-2"></i>Explorar acervo
              </a>
              <a href="/books/new" class="btn btn-light btn-lg rounded-pill px-4 fw-semibold text-success border border-success-subtle">
                <i class="bi bi-plus-circle me-2"></i>Cadastrar livro
              </a>
            </div>
          </div>
          <div class="col-lg-5 d-none d-lg-block">
            <div class="card border-0 rounded-4 shadow-sm bg-white">
              <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                  <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill">
                    <i class="bi bi-fire me-1 text-warning-emphasis"></i>Em alta
                  </span>
                  <i class="bi bi-quote display-5 text-success"></i>
                </div>
                <blockquote class="mb-4">
                  <p class="fs-4 fw-semibold text-body-emphasis mb-1">Quem mal lê, mal ouve, mal fala, mal vê.</p>
                  <footer class="blockquote-footer mt-2">
                    <cite title="Monteiro Lobato">Monteiro Lobato</cite>
                  </footer>
                </blockquote>
                <div class="row text-center g-2">
                  <div class="col-4">
                    <div class="bg-success-subtle rounded-3 py-2">
                      <div class="fs-4 fw-bolder text-success"><%= books.length %></div>
                      <div class="small text-body-secondary">livros</div>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="bg-success-subtle rounded-3 py-2">
                      <div class="fs-4 fw-bolder text-success">100%</div>
                      <div class="small text-body-secondary">digital</div>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="bg-warning-subtle rounded-3 py-2">
                      <div class="fs-4 fw-bolder text-warning-emphasis">∞</div>
                      <div class="small text-body-secondary">horas de leitura</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Recursos (bento grid) -->
    <section class="py-5 bg-body-tertiary">
      <div class="container">
        <div class="text-center mb-5">
          <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2 mb-2">Recursos</span>
          <h2 class="display-6 fw-bold mb-2 text-body-emphasis">Tudo o que você precisa em um só lugar</h2>
          <div class="col-lg-6 mx-auto">
            <p class="text-body-secondary mb-0">Uma experiência de leitura moderna, pensada para leitores de todas as idades.</p>
          </div>
        </div>

        <div class="row g-4">
          <!-- Card destaque (grande) -->
          <div class="col-12 col-lg-6">
            <div class="card border border-success-subtle rounded-4 shadow-sm bg-white h-100">
              <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3 mb-3">
                  <span class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-3 p-3">
                    <i class="bi bi-collection display-6"></i>
                  </span>
                  <div>
                    <h5 class="fw-bold text-body-emphasis mb-1">Acervo curado e em crescimento</h5>
                    <p class="text-body-secondary mb-0">Todos os títulos organizados, fáceis de encontrar e prontos para ler.</p>
                  </div>
                </div>
                <ul class="list-unstyled row row-cols-2 gy-2 mb-3 mt-4 small">
                  <li class="col-6 text-body-secondary"><i class="bi bi-check-circle-fill me-2 text-success"></i>Títulos atualizados</li>
                  <li class="col-6 text-body-secondary"><i class="bi bi-check-circle-fill me-2 text-success"></i>Leitura em qualquer tela</li>
                  <li class="col-6 text-body-secondary"><i class="bi bi-check-circle-fill me-2 text-success"></i>Acesso imediato</li>
                  <li class="col-6 text-body-secondary"><i class="bi bi-check-circle-fill me-2 text-success"></i>Sem filas de espera</li>
                </ul>
                <a href="#acervo" class="btn btn-success rounded-pill px-4">
                  <i class="bi bi-search me-1"></i>Ver acervo
                </a>
              </div>
            </div>
          </div>
          <!-- Cards pequenos -->
          <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 rounded-4 shadow-sm bg-success-subtle h-100">
              <div class="card-body p-4">
                <span class="d-inline-flex align-items-center justify-content-center bg-white text-success rounded-3 p-3 mb-3">
                  <i class="bi bi-people display-5"></i>
                </span>
                <h5 class="fw-semibold text-success-emphasis mb-1">Ampla variedade</h5>
                <p class="small text-body-secondary mb-0">Autores e gêneros para todos os gostos.</p>
              </div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 rounded-4 shadow-sm bg-warning-subtle h-100">
              <div class="card-body p-4">
                <span class="d-inline-flex align-items-center justify-content-center bg-white text-warning-emphasis rounded-3 p-3 mb-3">
                  <i class="bi bi-lightbulb display-5"></i>
                </span>
                <h5 class="fw-semibold text-warning-emphasis mb-1">Curadoria especial</h5>
                <p class="small text-body-secondary mb-0">Recomendações feitas por quem ama livros.</p>
              </div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border border-success-subtle rounded-4 shadow-sm bg-white h-100">
              <div class="card-body p-4">
                <span class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-3 p-3 mb-3">
                  <i class="bi bi-clock-history display-5"></i>
                </span>
                <h5 class="fw-semibold mb-1">Disponível 24/7</h5>
                <p class="small text-body-secondary mb-0">A qualquer hora, em qualquer lugar.</p>
              </div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border border-success-subtle rounded-4 shadow-sm bg-white h-100">
              <div class="card-body p-4">
                <span class="d-inline-flex align-items-center justify-content-center bg-warning-subtle text-warning-emphasis rounded-3 p-3 mb-3">
                  <i class="bi bi-rocket-takeoff display-5"></i>
                </span>
                <h5 class="fw-semibold mb-1">Inovação constante</h5>
                <p class="small text-body-secondary mb-0">Recursos novos a cada atualização.</p>
              </div>
            </div>
          </div>
          <!-- Como funciona -->
          <div class="col-12 col-lg-6">
            <div class="card border border-success-subtle rounded-4 shadow-sm bg-white h-100">
              <div class="card-body p-4">
                <div class="d-flex align-items-start gap-3 mb-4">
                  <span class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-3 p-3">
                    <i class="bi bi-compass display-6"></i>
                  </span>
                  <div>
                    <h5 class="fw-bold text-body-emphasis mb-1">Como funciona</h5>
                    <p class="text-body-secondary mb-0">Três passos simples até a próxima leitura.</p>
                  </div>
                </div>
                <div class="list-group list-group-flush">
                  <div class="list-group-item bg-transparent px-0">
                    <div class="d-flex gap-3">
                      <span class="badge bg-success-subtle text-success fw-bold rounded-3 fs-6">1</span>
                      <div>
                        <h6 class="mb-1 fw-semibold">Explore o acervo</h6>
                        <p class="text-body-secondary small mb-0">Navegue pelos títulos cadastrados.</p>
                      </div>
                    </div>
                  </div>
                  <div class="list-group-item bg-transparent px-0">
                    <div class="d-flex gap-3">
                      <span class="badge bg-success-subtle text-success fw-bold rounded-3 fs-6">2</span>
                      <div>
                        <h6 class="mb-1 fw-semibold">Escolha o seu favorito</h6>
                        <p class="text-body-secondary small mb-0">Leia a sinopse e comece já.</p>
                      </div>
                    </div>
                  </div>
                  <div class="list-group-item bg-transparent px-0 border-0">
                    <div class="d-flex gap-3">
                      <span class="badge bg-success-subtle text-success fw-bold rounded-3 fs-6">3</span>
                      <div>
                        <h6 class="mb-1 fw-semibold">Aproveite a leitura</h6>
                        <p class="text-body-secondary small mb-3">Boa leitura!</p>
                        <a href="/books/new" class="btn btn-success btn-sm rounded-pill px-3">
                          <i class="bi bi-plus-lg me-1"></i>Adicionar um livro
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Acervo -->
    <section id="acervo" class="py-5">
      <div class="container">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
          <div>
            <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2 mb-2">
              <i class="bi bi-collection me-1"></i>Acervo
            </span>
            <h2 class="display-6 fw-bold text-body-emphasis mb-0">Nossos livros</h2>
            <p class="text-body-secondary mb-0 mt-1">Títulos cadastrados e prontos para leitura.</p>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-white border border-success-subtle text-success rounded-pill px-3 py-2 fs-6">
              <i class="bi bi-book me-1"></i><%= books.length %> título(s)
            </span>
            <a href="/books/new" class="btn btn-success rounded-pill px-3">
              <i class="bi bi-plus-lg me-1"></i>Novo
            </a>
          </div>
        </div>

        <% if (books.length === 0) { %>
          <div class="card border border-success-subtle rounded-4 shadow-sm bg-white">
            <div class="card-body text-center py-5">
              <i class="bi bi-book display-3 text-success"></i>
              <h3 class="fw-semibold mt-3 text-body-emphasis">Ainda não há livros cadastrados</h3>
              <p class="text-body-secondary mb-4">Seja a primeira pessoa a adicionar um título ao acervo.</p>
              <a href="/books/new" class="btn btn-success btn-lg rounded-pill px-4">
                <i class="bi bi-plus-lg me-2"></i>Cadastrar o primeiro livro
              </a>
            </div>
          </div>
        <% } else { %>
          <div class="row g-4">
            <% books.forEach(book => { %>
              <%- include('../components/card_book.ejs', { book }) %>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>

    <!-- Newsletter -->
    <section class="py-5 bg-body-tertiary">
      <div class="container">
        <div class="card bg-success-subtle border-0 rounded-4 shadow-sm">
          <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center g-4">
              <div class="col-lg-6">
                <h3 class="fw-bold text-success-emphasis mb-2"><i class="bi bi-envelope-paper me-2"></i>Fique por dentro das novidades</h3>
                <p class="text-success-emphasis opacity-75 mb-0">Cadastre seu e-mail e receba os novos títulos do acervo.</p>
              </div>
              <div class="col-lg-6">
                <form class="d-flex gap-2">
                  <label class="visually-hidden" for="email">Seu e-mail</label>
                  <input type="email" id="email" class="form-control form-control-lg bg-white border-0" placeholder="Digite seu e-mail" required>
                  <button class="btn btn-success btn-lg rounded-pill px-4 flex-shrink-0" type="submit">
                    <i class="bi bi-send me-1"></i>Assinar
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Rodapé -->
    <footer class="bg-white py-5 mt-auto border-top border-success-subtle">
      <div class="container">
        <div class="row g-4">
          <div class="col-lg-4">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-body-emphasis mb-2" href="/">
              <span class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-3 p-2">
                <i class="bi bi-book-half"></i>
              </span>
              BibliotecaVirtual
            </a>
            <p class="small text-body-secondary mb-3">Um espaço digital onde histórias ganham vida e a leitura encontra seu lugar.</p>
            <div class="d-flex gap-2">
              <a href="#" class="btn btn-outline-success btn-sm rounded-circle" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
              <a href="#" class="btn btn-outline-success btn-sm rounded-circle" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
              <a href="#" class="btn btn-outline-success btn-sm rounded-circle" aria-label="Twitter / X"><i class="bi bi-twitter-x"></i></a>
              <a href="#" class="btn btn-outline-success btn-sm rounded-circle" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
            </div>
          </div>
          <div class="col-6 col-lg-2">
            <h6 class="fw-semibold text-body-emphasis mb-3">Navegação</h6>
            <ul class="list-unstyled small d-flex flex-column gap-2">
              <li><a class="link-success link-offset-2 link-underline-opacity-25" href="/">Início</a></li>
              <li><a class="link-success link-offset-2 link-underline-opacity-25" href="#acervo">Acervo</a></li>
              <li><a class="link-success link-offset-2 link-underline-opacity-25" href="/books/new">Cadastrar livro</a></li>
            </ul>
          </div>
          <div class="col-6 col-lg-3">
            <h6 class="fw-semibold text-body-emphasis mb-3">Contato</h6>
            <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
              <li class="text-body-secondary"><i class="bi bi-geo-alt me-2 text-success"></i>Rua das Letras, 101</li>
              <li class="text-body-secondary"><i class="bi bi-envelope me-2 text-success"></i>contato@bibliotecavirtual.com</li>
              <li class="text-body-secondary"><i class="bi bi-telephone me-2 text-success"></i>+55 11 4002-8922</li>
            </ul>
          </div>
          <div class="col-lg-3">
            <h6 class="fw-semibold text-body-emphasis mb-3">Horário</h6>
            <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
              <li class="text-body-secondary"><i class="bi bi-clock me-2 text-success"></i>Segunda a sexta: 8h às 18h</li>
              <li class="text-body-secondary"><i class="bi bi-clock me-2 text-success"></i>Sábado: 9h às 14h</li>
              <li class="text-body-secondary"><i class="bi bi-moon-stars me-2 text-success"></i>Online 24 horas</li>
            </ul>
          </div>
        </div>
        <div class="border-top border-success-subtle pt-4 mt-4 text-center small text-body-secondary">
          © 2026 Biblioteca Virtual — Todos os direitos reservados.
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  </body>
</html>